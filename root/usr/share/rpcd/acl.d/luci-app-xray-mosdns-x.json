{
	"luci-app-xray-mosdns-x": {
		"description": "Grant access to Xray + mosdns-x configuration, status, traffic and import",
		"read": {
			"uci": [
				"xray-mosdns"
			],
			"file": {
				"/usr/libexec/xray-mosdns/status.sh": [
					"exec"
				],
				"/usr/libexec/xray-mosdns/log.sh": [
					"exec"
				],
				"/usr/libexec/xray-mosdns/traffic.sh": [
					"exec"
				],
				"/usr/libexec/xray-mosdns/latency.sh": [
					"exec"
				],
				"/usr/libexec/xray-mosdns/check-connect.sh": [
					"exec"
				],
				"/usr/libexec/xray-mosdns/geoview.uc": [
					"exec"
				],
				"/usr/libexec/xray-mosdns/querylog.uc": [
					"exec"
				],
				"/usr/libexec/xray-mosdns/info.sh": [
					"exec"
				]
			}
		},
		"write": {
			"uci": [
				"xray-mosdns"
			],
			"file": {
				"/tmp/xray-mosdns-import.txt": [
					"write"
				],
				"/usr/libexec/xray-mosdns/import-links.sh": [
					"exec"
				],
				"/usr/libexec/xray-mosdns/update.sh": [
					"exec"
				],
				"/etc/init.d/xray-mosdns": [
					"exec"
				],
				"/usr/libexec/xray-mosdns/groups.uc": [
					"exec"
				],
				"/usr/libexec/xray-mosdns/adlist.uc": [
					"exec"
				]
			}
		}
	}
}
