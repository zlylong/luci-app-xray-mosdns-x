#!/bin/sh
# Ensure new options exist after upgrades (idempotent)
[ -f /etc/config/xray-mosdns ] || exit 0
uci -q get xray-mosdns.@dns[0] >/dev/null 2>&1 || {
	uci batch <<-EOC
	set xray-mosdns.dns=dns
	set xray-mosdns.dns.enabled='1'
	set xray-mosdns.dns.mosdns_bin='/usr/bin/mosdns'
	set xray-mosdns.dns.listen_port='5353'
	set xray-mosdns.dns.xray_dns_port='15353'
	set xray-mosdns.dns.cache_size='8192'
	set xray-mosdns.dns.cache_everything='1'
	set xray-mosdns.dns.adblock='1'
	set xray-mosdns.dns.filter_proxy_ipv6='1'
	set xray-mosdns.dns.bootstrap='223.5.5.5'
	EOC
	uci commit xray-mosdns
}
for opt in node_mode balancer_strategy ipv6_enabled socks_port; do
	uci -q get "xray-mosdns.@global[0].$opt" >/dev/null 2>&1 || {
		case "$opt" in
			node_mode) uci set xray-mosdns.@global[0].node_mode='single' ;;
			balancer_strategy) uci set xray-mosdns.@global[0].balancer_strategy='leastLoad' ;;
			ipv6_enabled) uci set xray-mosdns.@global[0].ipv6_enabled='0' ;;
			socks_port) uci set xray-mosdns.@global[0].socks_port='1070' ;;
		esac
	}
done
uci commit xray-mosdns
exit 0
