#!/bin/sh /etc/rc.common
# luci-app-xray-mosdns-x - service control
#
# start is idempotent and doubles as reload. The configuration is generated
# into a staging directory and checked: Xray has to accept it and the
# firewall rules have to load. Only then do the daemons' files change, and
# procd restarts only the daemon whose file did (Xray's routing rules go
# into the running Xray instead). Anything that fails leaves
# the running state as it was, and the reason is kept for the overview page.
START=96
USE_PROCD=1

PLUGIN_DIR=/usr/share/xray-mosdns
OUT=/var/etc/xray-mosdns
NEW=/var/etc/xray-mosdns.new
ERR=/var/run/xray-mosdns.error
MOSDNS_LOG=/tmp/mosdns-x.log
# the routing rules Xray had before a switch; a number that changes when
# Xray has to be restarted although its files say it need not
RULES_WAS=/var/run/xray-mosdns-rules.was
XRAY_GEN=/var/run/xray-mosdns-xray.gen

get_opt() { uci -q get "xray-mosdns.$1" 2>/dev/null; }
sum() { [ -f "$1" ] && md5sum "$1" 2>/dev/null | cut -d' ' -f1; }

passwall_running() {
	ps w 2>/dev/null | grep -v grep | grep -qE '/tmp/etc/passwall2?/' && return 0
	return 1
}

teardown() {
	"$PLUGIN_DIR/fw.sh" clear >/dev/null 2>&1 || true
}

# $1 = what went wrong, in one line: logged, and shown on the overview page
set_error() {
	msg=$(printf '%s' "$1" | tr '\n\t' '  ')
	logger -p daemon.err -t xray-mosdns "$msg"
	echo "ERROR: $msg" >&2
	printf '%s\n' "$msg" > "$ERR"
}

# Things without which the service cannot work at all; prints the first
# one missing. The TProxy check loads a throwaway rule in check mode, which
# also works when the module is built into the kernel.
preflight() {
	[ -x "$XRAY_BIN" ] || { echo "找不到可执行的 Xray：$XRAY_BIN"; return 1; }
	[ -x "$MOSDNS_BIN" ] || { echo "找不到可执行的 mosdns-x：$MOSDNS_BIN"; return 1; }
	[ -r "$GEO_DIR/geosite.dat" ] && [ -r "$GEO_DIR/geoip.dat" ] || {
		echo "$GEO_DIR 下缺少 geosite.dat / geoip.dat，可以到“更新”页下载"
		return 1
	}
	nft -c -f - >/dev/null 2>&1 <<-EOF || { echo "内核不支持 nft TProxy：请安装 kmod-nft-tproxy"; return 1; }
		add table inet xm_preflight
		add chain inet xm_preflight c { type filter hook prerouting priority mangle; }
		add rule inet xm_preflight c meta l4proto tcp tproxy ip to 127.0.0.1:1
	EOF
}

# $1 = file with the output of a failed step: its most telling line
reason() {
	r=$(grep -E 'ERROR|[Ff]ail|[Ee]rror|[Ii]nvalid' "$1" | tail -1)
	[ -n "$r" ] || r=$(tail -1 "$1")
	printf '%s' "$r" | sed 's/^ERROR: //' | cut -c1-300
}

start_service() {
	# One start at a time, and none while a stop runs: rc.common takes this
	# lock (fd 1000) around stop but not around start, and a reload is a
	# start here (LuCI's restart, Save & Apply, interface events and the
	# group watcher can all ask for one at once). A start that finds one
	# running waits for it, then applies the configuration as it is by
	# then. Held until this script exits, service_started included.
	procd_lock

	# configs written by <= 0.8 pointed dnsmasq at mosdns; undo that once
	"$PLUGIN_DIR/dnsmasq.sh" revert || true

	[ "$(get_opt '@global[0].enabled')" = "1" ] || {
		teardown
		rm -f "$ERR"
		echo "xray-mosdns is disabled (xray-mosdns.global.enabled=0)"
		return 0
	}
	# two transparent proxies fighting over the same packets and DNS never works
	if passwall_running; then
		set_error "PassWall 正在运行，已拒绝启动：请先停止 PassWall"
		teardown
		return 1
	fi

	# blocklist subscriptions: keep the daily job in step with the settings
	ucode /usr/libexec/xray-mosdns/adlist.uc cron-sync >/dev/null 2>&1 1000>&-

	# what the new configuration asks for (UCI)
	uci_values

	# the generated files and the config hold node credentials, the query log
	# holds who looked up what: root only
	umask 077
	mkdir -p "$OUT"
	chmod 700 "$OUT"
	chmod 600 /etc/config/xray-mosdns 2>/dev/null
	[ -e "$MOSDNS_LOG" ] || : > "$MOSDNS_LOG"
	chmod 600 "$MOSDNS_LOG"

	bad=""
	broken=""
	if ! problem=$(preflight); then
		# What runs keeps running: a mistyped path or a geo file moved away
		# for a moment must not take the proxy and DNS down with it.
		if nft list table inet xray-mosdns >/dev/null 2>&1 && have_previous; then
			bad="$problem"
		else
			set_error "$problem"
			teardown
			return 1
		fi
	else
		# what mosdns counted since the last sample, before a new config restarts it
		ucode /usr/libexec/xray-mosdns/stats.uc sample >/dev/null 2>&1 1000>&-
		generate_and_switch
	fi

	# Neither set is whole in $OUT: nothing can run on it. Stopping leaves
	# LAN traffic and DNS as they are without the service.
	if [ -n "$broken" ]; then
		set_error "$bad；上一份配置也无法完整恢复（剩下的在 $OUT/.prev），服务已停止"
		teardown
		return 1
	fi

	if [ -n "$bad" ]; then
		if ! have_previous; then
			set_error "$bad"
			teardown
			return 1
		fi
		set_error "$bad（继续使用上一份配置）"
		# Its rules may have been cleared by a stop since. fw.sh takes the
		# mark and table from the previous files' runtime.env, not from UCI.
		"$PLUGIN_DIR/fw.sh" apply >/dev/null 2>&1 || {
			set_error "$bad；上一份配置的防火墙规则也无法加载"
			teardown
			return 1
		}
	fi

	# Before mosdns: the merged blocklists it reads have to be there, or it
	# does not start; ensure makes missing ones from the lists there are.
	# Lists that were just added are fetched in the background (start does
	# not wait), into where the new configuration reads them, after the move
	# above so that the two do not write the same files. The download must
	# not hold the start lock: fd 1000 is closed for it. What ensure could
	# not fix is said on the overview, unless something else is already.
	why=$(ucode /usr/libexec/xray-mosdns/adlist.uc ensure 2>&1 >/dev/null 1000>&-)
	[ -n "$why" ] && [ ! -s "$ERR" ] && set_error "拦截列表：$why（mosdns 读不到合并后的列表时无法启动）"

	# The daemons as the files in effect want them: with the previous set's
	# binaries, ports and geo directory when the new set was not taken.
	runtime_values
	declare_instances
}

# a previous set of files to keep running on
have_previous() {
	[ -f "$OUT/xray.json" ] && [ -f "$OUT/nft.rules" ]
}

uci_values() {
	XRAY_BIN=$(get_opt '@global[0].xray_bin'); [ -n "$XRAY_BIN" ] || XRAY_BIN=/usr/bin/xray
	MOSDNS_BIN=$(get_opt '@dns[0].mosdns_bin'); [ -n "$MOSDNS_BIN" ] || MOSDNS_BIN=/usr/bin/mosdns
	GEO_DIR=$(get_opt '@global[0].geo_dir'); GEO_DIR=${GEO_DIR%/}; [ -n "$GEO_DIR" ] || GEO_DIR=/usr/share/v2ray
	TPROXY_PORT=$(get_opt '@global[0].tproxy_port'); [ -n "$TPROXY_PORT" ] || TPROXY_PORT=12345
	DNS_WATCH=log-only
	[ "$(get_opt '@dns[0].redirect')" != "0" ] && [ "$(get_opt '@dns[0].fallback')" != "0" ] && DNS_WATCH=manage
}

# The values the files in effect were generated with (runtime.env); a set
# from before that file existed goes by UCI.
runtime_values() {
	uci_values
	[ -f "$OUT/runtime.env" ] && . "$OUT/runtime.env"
}

# ---- new configuration: generated aside, checked, then switched to; sets
# $bad when it was not taken, and $broken as well when the old set could
# not be kept whole either
generate_and_switch() {
	rm -rf "$NEW"
	mkdir -p "$NEW"
	# the generator reads two things back from its output: sets extracted from
	# geoip.dat (a cache) and the DNS redirect rule, which it only rewrites
	# when it changes since the watchdog re-applies it when the file is newer
	cp -p "$OUT"/geoip-*.json "$OUT"/nft-dns-on.rules "$NEW"/ 2>/dev/null
	if ! ucode "$PLUGIN_DIR/gen-config.uc" -o "$NEW" >"$NEW/.log" 2>&1; then
		bad="配置生成失败：$(reason "$NEW/.log")"
	elif ! XRAY_LOCATION_ASSET="$GEO_DIR" "$XRAY_BIN" run -test -c "$NEW/xray.json" >"$NEW/.log" 2>&1; then
		bad="Xray 不接受生成的配置：$(reason "$NEW/.log")"
	else
		# The rules are loaded from the new files before anything else
		# changes: if they do not load, the old table and the daemons' old
		# files are all still in place. Addresses learned from DNS belong
		# to the old rules once those change.
		flush=""
		[ "$(sum "$OUT/mosdns.yaml")" = "$(sum "$NEW/mosdns.yaml")" ] || flush="flush-dns"
		if XM_RULES_DIR="$NEW" "$PLUGIN_DIR/fw.sh" apply $flush >"$NEW/.log" 2>&1; then
			rm -f "$NEW/.log"
			# all files or none: when they cannot all be put in place the
			# old set is back whole, and the code below puts its rules back
			# too. The new set stays in $NEW to look at.
			was=$(cat "$OUT/xray.restart" 2>/dev/null)
			rm -f "$RULES_WAS"
			cp -p "$OUT/xray-rules.json" "$RULES_WAS" 2>/dev/null
			"$PLUGIN_DIR/switch.sh" "$NEW" "$OUT" 2>"$OUT/.switch.log"
			rc=$?
			# its first line says what failed
			[ "$rc" = 0 ] || bad="新配置无法替换到 $OUT：$(head -n 1 "$OUT/.switch.log" | cut -c1-300)"
			case $rc in
				0)
					rm -rf "$NEW"; rm -f "$ERR"
					# The new set reads the blocklists from where they are
					# now kept; lists an older version kept elsewhere move
					# there only at this point, never on a start that falls
					# back to the previous set. procd restarts mosdns on
					# the new set once this script is done. What could not
					# move is said on the overview (ensure below fetches
					# what the new set is missing); exit 2, an update
					# running, is only logged: it writes where the new set
					# reads.
					why=$(ucode /usr/libexec/xray-mosdns/adlist.uc migrate 2>&1 >/dev/null 1000>&-)
					[ "$?" = 1 ] && set_error "拦截列表有文件没能搬进 xray-mosdns 子目录：$why（见系统日志，下次启动重试）"
					hot_rules "$was" ;;
				3) broken=1 ;;
			esac
			rm -f "$OUT/.switch.log"
		else
			bad="防火墙规则加载失败：$(reason "$NEW/.log")"
		fi
	fi
}

# $1 = xray.restart of the set that was in place. When Xray's rules are all
# that changed for it, they go into the running Xray through its API: no
# restart, so connections and the node groups' state stay. When that does
# not work (Xray is down, the API refuses) Xray is restarted instead: a
# start reads the same rules from xray.json.
hot_rules() {
	[ -n "$1" ] && [ -f "$RULES_WAS" ] && [ "$1" = "$(cat "$OUT/xray.restart" 2>/dev/null)" ] || return 0
	cmp -s "$RULES_WAS" "$OUT/xray-rules.json" && return 0
	runtime_values
	if why=$(XRAY_BIN="$XRAY_BIN" API_PORT="$API_PORT" GEO_DIR="$GEO_DIR" \
		"$PLUGIN_DIR/xray-rules.sh" apply "$RULES_WAS" "$OUT/xray-rules.json" 2>&1 1000>&-); then
		logger -t xray-mosdns "Xray: the routing rules were replaced through its API, no restart"
	else
		echo $(($(cat "$XRAY_GEN" 2>/dev/null || echo 0) + 1)) > "$XRAY_GEN"
		logger -p daemon.warn -t xray-mosdns "Xray: the routing rules could not be replaced through its API ($(echo "$why" | tail -n 1 | cut -c1-200)): restarting it"
	fi
}

declare_instances() {
	# mosdns-x is part of the service: it runs whenever the service does
	procd_open_instance mosdns
	procd_set_param command "$MOSDNS_BIN" start -c "$OUT/mosdns.yaml" -d "$OUT"
	procd_set_param file "$OUT/mosdns.yaml"
	procd_set_param respawn 3600 5 5
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance

	# Owns the LAN port-53 redirect: installed only while mosdns answers,
	# so a dead mosdns leaves DNS with dnsmasq instead of timing out.
	# Without that job it still runs, to keep the mosdns log file bounded,
	# and in either mode it watches Xray.
	# helpers are started by their own path, not through an interpreter, so
	# that procd logs their output under their name (log.sh sorts by it)
	procd_open_instance dnswatch
	procd_set_param command /usr/libexec/xray-mosdns/dns-watchdog.sh "$DNS_WATCH"
	# an updated script restarts it, like a changed config does the daemons
	procd_set_param file /usr/libexec/xray-mosdns/dns-watchdog.sh
	procd_set_param respawn 3600 5 0
	procd_set_param stderr 1
	procd_close_instance

	# keeps "ordered" groups on their first healthy member and re-applies pins
	if grep -q '"tag"' "$OUT/groups.json" 2>/dev/null; then
		procd_open_instance groups
		procd_set_param command /usr/libexec/xray-mosdns/groups.uc watch
		procd_set_param file "$OUT/groups.json" /usr/libexec/xray-mosdns/groups.uc
		procd_set_param respawn 3600 5 5
		procd_set_param stderr 1
		procd_close_instance
	fi

	procd_open_instance xray
	procd_set_param command "$XRAY_BIN" run -c "$OUT/xray.json"
	# Xray looks for geoip.dat / geosite.dat next to its binary and under
	# */share/xray; the rules need the same files mosdns and the kernel use
	# XM_GEN: see hot_rules
	procd_set_param env XRAY_LOCATION_ASSET="$GEO_DIR" XM_GEN="$(cat "$XRAY_GEN" 2>/dev/null)"
	# xray.restart names everything of xray.json but the routing rules:
	# those are replaced in the running Xray (hot_rules). A set from before
	# that file existed restarts Xray whenever xray.json changes.
	if [ -f "$OUT/xray.restart" ]; then
		procd_set_param file "$OUT/xray.restart"
	else
		procd_set_param file "$OUT/xray.json"
	fi
	procd_set_param respawn 3600 5 5
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}

# $1 = port: a TCP socket is listening on it (IPv4 or IPv6)
listening() {
	hex=$(printf '%04X' "$1")
	grep -qE "^ *[0-9]+: [0-9A-F]+:$hex [0-9A-F]+:0000 0A " /proc/net/tcp /proc/net/tcp6 2>/dev/null
}

# After procd has (re)started the daemons: the rules send proxied traffic
# to Xray's TProxy port. If Xray does not come up there, the transparent
# proxy is taken out of the path (fw.sh gate), so that traffic goes out
# directly rather than into a closed port; the watchdog puts it back once
# Xray listens, and does the same for a crash later on.
#
# A start that finds the proxy already out of the path (Xray was down) keeps
# it out from the first moment: fw.sh apply carries that over in the same
# transaction, so there is no window into the closed port.
service_started() {
	[ "$(get_opt '@global[0].enabled')" = "1" ] && [ -f "$OUT/nft.rules" ] || return 0
	nft list table inet xray-mosdns >/dev/null 2>&1 || return 0
	runtime_values
	if "$PLUGIN_DIR/fw.sh" gated; then
		# still out of the path from before this start: switching to new
		# files cleared the overview's message, gate puts it back (and
		# changes nothing else). The watchdog puts the proxy back once Xray
		# listens.
		"$PLUGIN_DIR/fw.sh" gate >/dev/null 2>&1
		return 0
	fi
	i=0
	while [ $i -lt 15 ]; do
		listening "$TPROXY_PORT" && return 0
		sleep 1
		i=$((i + 1))
	done
	if "$PLUGIN_DIR/fw.sh" gate 2>"$OUT/.gate.log"; then
		logger -p daemon.warn -t xray-mosdns "Xray is not listening on :$TPROXY_PORT after the start: transparent proxy taken out, traffic goes out directly until it is back"
	else
		set_error "Xray 没有在 TProxy 端口 $TPROXY_PORT 上监听，透明代理也无法撤下：$(reason "$OUT/.gate.log")"
	fi
	rm -f "$OUT/.gate.log"
}

stop_service() {
	# the DNS counts onto flash while mosdns still runs (it goes after this)
	ucode /usr/libexec/xray-mosdns/stats.uc flush >/dev/null 2>&1 1000>&-
	teardown
	rm -f "$ERR"
}

service_triggers() {
	procd_add_reload_trigger "xray-mosdns"
	# the LAN device name is baked into the ruleset
	ifaces=$(get_opt '@global[0].lan_ifaces'); [ -n "$ifaces" ] || ifaces=lan
	for i in $ifaces; do
		procd_add_reload_interface_trigger "$i"
	done
	# ECS from the router's public address: a new one (a PPPoE redial) needs
	# a new config; the generator says which interfaces carry it
	ecs_ifaces=$( [ -f "$OUT/runtime.env" ] && . "$OUT/runtime.env"; echo "${ECS_IFACES:-}" )
	for i in $ecs_ifaces; do
		case "$i" in *[!A-Za-z0-9_-]*) continue ;; esac
		procd_add_reload_interface_trigger "$i"
	done
}
