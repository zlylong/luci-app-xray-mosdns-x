#!/bin/sh /etc/rc.common
# luci-app-xray-mosdns-x - service control
#
# start is idempotent and doubles as reload: the configuration is
# regenerated, the nftables ruleset is re-applied in one transaction, and
# procd restarts only the daemon whose configuration file actually changed.
START=96
USE_PROCD=1

PLUGIN_DIR=/usr/share/xray-mosdns
OUT=/var/etc/xray-mosdns

get_opt() { uci -q get "xray-mosdns.$1" 2>/dev/null; }
sum() { [ -f "$1" ] && md5sum "$1" 2>/dev/null | cut -d' ' -f1; }

passwall_running() {
	ps w 2>/dev/null | grep -v grep | grep -q '/tmp/etc/passwall' && return 0
	return 1
}

teardown() {
	"$PLUGIN_DIR/fw.sh" clear >/dev/null 2>&1 || true
}

start_service() {
	# configs written by <= 0.8 pointed dnsmasq at mosdns; undo that once
	"$PLUGIN_DIR/dnsmasq.sh" revert || true

	[ "$(get_opt '@global[0].enabled')" = "1" ] || {
		teardown
		echo "xray-mosdns is disabled (xray-mosdns.global.enabled=0)"
		return 0
	}
	# two transparent proxies fighting over the same packets and DNS never works
	if passwall_running; then
		logger -t xray-mosdns "PassWall is running - refusing to start, stop it first"
		echo "ERROR: PassWall is running, stop it first" >&2
		teardown
		return 1
	fi

	# blocklist subscriptions: keep the daily job in step with the settings and
	# fetch lists that were just added (in the background, start does not wait)
	ucode /usr/libexec/xray-mosdns/adlist.uc cron-sync >/dev/null 2>&1
	ucode /usr/libexec/xray-mosdns/adlist.uc ensure >/dev/null 2>&1

	XRAY_BIN=$(get_opt '@global[0].xray_bin'); [ -n "$XRAY_BIN" ] || XRAY_BIN=/usr/bin/xray
	MOSDNS_BIN=$(get_opt '@dns[0].mosdns_bin'); [ -n "$MOSDNS_BIN" ] || MOSDNS_BIN=/usr/bin/mosdns

	mkdir -p "$OUT"
	dns_before=$(sum "$OUT/mosdns.yaml")
	if ! ucode "$PLUGIN_DIR/gen-config.uc" -o "$OUT"; then
		logger -t xray-mosdns "config generation failed"
		echo "ERROR: config generation failed (see logread -e xray-mosdns)" >&2
		# files are replaced atomically, so a previous good set is still intact:
		# keep running on it rather than dropping the proxy
		[ -f "$OUT/xray.json" ] && [ -f "$OUT/nft.rules" ] || {
			teardown
			return 1
		}
		logger -t xray-mosdns "keeping the previous configuration"
	fi

	# addresses learned from DNS belong to the old rules once those change
	flush=""
	[ "$dns_before" = "$(sum "$OUT/mosdns.yaml")" ] || flush="flush-dns"
	"$PLUGIN_DIR/fw.sh" apply $flush || {
		teardown
		return 1
	}

	if [ "$(get_opt '@dns[0].enabled')" != "0" ]; then
		procd_open_instance mosdns
		procd_set_param command "$MOSDNS_BIN" start -c "$OUT/mosdns.yaml" -d "$OUT"
		procd_set_param file "$OUT/mosdns.yaml"
		procd_set_param respawn 3600 5 5
		procd_set_param stdout 1
		procd_set_param stderr 1
		procd_close_instance

		# Owns the LAN port-53 redirect: installed only while mosdns answers,
		# so a dead mosdns leaves DNS with dnsmasq instead of timing out.
		# Without that job it still runs, to keep the mosdns log file bounded.
		wd_mode=log-only
		[ "$(get_opt '@dns[0].redirect')" != "0" ] && [ "$(get_opt '@dns[0].fallback')" != "0" ] && wd_mode=manage
		procd_open_instance dnswatch
		procd_set_param command /bin/sh /usr/libexec/xray-mosdns/dns-watchdog.sh "$wd_mode"
		procd_set_param respawn 3600 5 0
		procd_set_param stderr 1
		procd_close_instance
	fi

	# keeps "ordered" groups on their first healthy member and re-applies pins
	if grep -q '"tag"' "$OUT/groups.json" 2>/dev/null; then
		procd_open_instance groups
		procd_set_param command /usr/bin/ucode /usr/libexec/xray-mosdns/groups.uc watch
		procd_set_param file "$OUT/groups.json"
		procd_set_param respawn 3600 5 5
		procd_set_param stderr 1
		procd_close_instance
	fi

	procd_open_instance xray
	procd_set_param command "$XRAY_BIN" run -c "$OUT/xray.json"
	procd_set_param file "$OUT/xray.json"
	procd_set_param respawn 3600 5 5
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}

stop_service() {
	teardown
}

service_triggers() {
	procd_add_reload_trigger "xray-mosdns"
	# the LAN device name is baked into the ruleset
	ifaces=$(get_opt '@global[0].lan_ifaces'); [ -n "$ifaces" ] || ifaces=lan
	for i in $ifaces; do
		procd_add_reload_interface_trigger "$i"
	done
}
