# Xray + mosdns-x transparent proxy configuration
# Values below are conservative defaults; the plugin is DISABLED until
# `option enabled '1'` is set and /etc/init.d/xray-mosdns is started.

config global 'global'
	# master switch (0 = installed but inactive)
	option enabled '0'
	# port that Xray tproxy inbound listens on
	option tproxy_port '12345'
	# fwmark used by the tproxy policy routing (keep unique on this router)
	option fwmark '0x1'
	# policy routing table for local delivery of tproxy'ed packets
	option route_table '100'
	# log verbosity of Xray: debug|info|warning|error|none
	option log_level 'warning'
	# sniffing (destOverride http/tls/quic) needed by domain based routing
	option sniffing '1'
	# optional: '/usr/bin/xray' or an alternative build
	option xray_bin '/usr/bin/xray'
	# internal SOCKS inbound port, used by mosdns for foreign DNS
	option socks_port '1070'
	# local Xray stats API port (node traffic counters)
	option api_port '10085'
	# config layout version (set by the package, do not change)
	option schema '2'
	# 分流总节点: direct | <node section> | <group section>
	option main_target 'direct'
	# health probe used by node groups
	option probe_url 'https://www.gstatic.com/generate_204'
	option probe_interval '1m'
	# optional: switched to automatically when every group member fails the probe at once
	#option probe_url_backup 'https://cp.cloudflare.com/generate_204'
	# proxy the router's own connections as well: 0 | tcp | tcp,udp
	option proxy_router '0'
	# socket mark on everything Xray and mosdns send themselves (loop prevention)
	option self_mark '0xff'
	# decide proxy-vs-direct in nftables so direct traffic never enters Xray
	option kernel_split '1'
	# logical interfaces whose traffic is proxied, e.g. lan, a guest network, a VPN
	# interface (traffic entering from anything else, including WAN, is never touched)
	list lan_ifaces 'lan'
	# also proxy/tproxy IPv6 traffic (experimental)
	option ipv6_enabled '0'
	# traffic no rule claims: proxy (via 分流总节点) | direct
	option default_action 'proxy'
	# scheduled geo data update (cron): 0/1, hour of day, and day of the
	# week (0 = Sunday ... 6) or * for every day
	option geo_auto_update '0'
	option geo_update_hour '4'
	option geo_update_day '*'
	# extra destination CIDRs/IPs that must never be tproxy'ed
	list bypass_ips ''

config dns 'dns'
	# mosdns-x / mosdns binary (manual build allowed)
	option mosdns_bin '/usr/bin/mosdns'
	# port mosdns listens on (avoid 5353, it belongs to mDNS)
	option listen_port '5335'
	# redirect every LAN port-53 query to mosdns in nftables (dnsmasq is not reconfigured)
	option redirect '1'
	# watchdog: while mosdns is not answering, remove the redirect so dnsmasq serves the LAN
	option fallback '1'
	# cache entries
	option cache_size '8192'
	# cache queries carrying EDNS (needed by most modern clients)
	option cache_everything '1'
	# answer AAAA queries with an empty response:
	#   for proxied domains (keeps them from bypassing the proxy over IPv6)
	option filter_proxy_ipv6 '1'
	#   for direct domains (when the uplink has no usable IPv6)
	option filter_direct_ipv6 '0'
	# bootstrap resolvers used to reach DoH/DoT upstreams by name (direct,
	# mainland); several go round the upstreams in turn
	list bootstrap '223.5.5.5'
	# foreign DNS servers, always queried through the proxy: an IP address
	# (plain DNS over TCP) or a tcp:// tls:// https:// URL
	list remote_dns '1.1.1.1'
	list remote_dns '8.8.8.8'
	# answer for blocked names: nxdomain | zero (0.0.0.0 and ::)
	option block_mode 'nxdomain'
	# raise answer TTLs below this many seconds (0 = leave them alone)
	option min_ttl '0'
	# log every query to /tmp/mosdns-x.log for the query log page
	option query_log '0'
	# domestic upstreams (DoH/DoT/plain) - one per line
	list domestic_dns 'https://dns.alidns.com/dns-query'
	list domestic_dns 'https://doh.pub/dns-query'
	# static hosts entries: "<domain> <ip>"
	list hosts ''

# enabled '0' = 不生成、不可选
config node 'node_example'
	option enabled '0'
	option remarks 'example'
	option type 'vless'
	option address ''
	option port '443'
	option uuid ''
	option flow ''
	option tls '1'
	option tls_server_name ''
	option fingerprint 'chrome'
	# transport: tcp | ws | grpc | http | xhttp
	option transport 'tcp'
	option path '/'
	option host ''
	option service_name ''

# 拦截列表订阅。列表为 AdGuard Home 的规则格式，由 adlist.uc 下载并转换
config adblock 'adblock'
	# 转换后的列表存放目录（列表较大，注意闪存空间）
	option dir '/etc/xray-mosdns/adlists'
	# 每天自动更新，以及更新的钟点
	option auto_update '1'
	option update_hour '5'

