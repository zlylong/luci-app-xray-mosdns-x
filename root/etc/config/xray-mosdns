# 节点组：把几个节点组合成一个出口，可以像节点一样被选作总节点或规则出口
# strategy: fastest（最快）| ordered（按顺序，列表顺序即优先级）| roundrobin | random
# fallback: 成员全部不可用时的出口，direct | block | <node section>
# failback: 仅 ordered。0（默认）= 切换后只有当前成员不可用才再切；1 = 前面的成员恢复后立即切回
#config group 'hk'
#	option remarks '香港'
#	option strategy 'fastest'
#	list member 'node_a'
#	list member 'node_b'
#	option fallback 'direct'

# 分流规则：从上到下匹配，第一条命中的生效
# rule_type: domain | ip | port | network
# outbound:  main（跟随分流总节点）| direct | block | <node section> | <group section>
# 下面几条是预置规则，和你自己加的规则没有区别，可以关掉、修改、调整顺序。
# 订阅的拦截列表（在 DNS 页的“广告过滤”标签里添加）。adlist:all 表示所有已启用的订阅
config rule 'builtin_adlist'
	option enabled '1'
	option remarks '广告（订阅列表）'
	option rule_type 'domain'
	list value 'adlist:all'
	option outbound 'block'

config rule 'builtin_cn_domain'
	option enabled '1'
	option remarks '国内域名'
	option rule_type 'domain'
	list value 'geosite:cn'
	option outbound 'direct'

config rule 'builtin_cn_ip'
	option enabled '1'
	option remarks '国内 IP'
	option rule_type 'ip'
	list value 'geoip:cn'
	option outbound 'direct'

config rule 'builtin_noncn'
	option enabled '1'
	option remarks '非国内域名'
	option rule_type 'domain'
	list value 'geosite:geolocation-!cn'
	option outbound 'main'

config rule 'builtin_gfw'
	option enabled '0'
	option remarks 'GFW 列表'
	option rule_type 'domain'
	list value 'geosite:gfw'
	option outbound 'main'

