config global 'global'
	option enabled '1'
	option main_target 'hk1'
	option rule_mode 'gfw'
	option ipv6_enabled '1'
	list lan_devices 'br-lan'
	list lan_devices 'br-guest'

config dns 'dns'
	option enabled '1'
	option listen_port '5335'
	option filter_proxy_ipv6 '0'
	option adblock '0'

config node 'hk1'
	option enabled '1'
	option type 'hysteria2'
	option address '2001:db8:1::5'
	option port '443'
	option password 'secret'
	option tls_server_name 'hy.example.net'

# rule values written by the 0.9 UI are uci lists
config rule
	option enabled '1'
	option rule_type 'port'
	list value '22'
	list value '3389'
	option outbound 'direct'

config rule
	option enabled '1'
	option rule_type 'domain'
	list value 'geosite:openai'
	list value 'domain:example.org'
	option outbound 'main'
