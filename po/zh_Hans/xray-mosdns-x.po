msgid "mosdns-x handles client DNS: mainland domains are resolved through the domestic upstreams, everything else is sent through the proxy via the internal SOCKS inbound."
msgstr "mosdns-x 接管客户端 DNS：国内域名走国内上游解析，其余域名通过内部 SOCKS 入站经代理解析。"

msgid "Enable mosdns-x"
msgstr "启用 mosdns-x"

msgid "When enabled, dnsmasq is pointed at the local mosdns listener and restored on stop."
msgstr "启用后 dnsmasq 会指向本地 mosdns 监听端口，停止时自动还原。"

msgid "mosdns binary"
msgstr "mosdns 程序路径"

msgid "mosdns listen port"
msgstr "mosdns 监听端口"

msgid "dnsmasq will forward to 127.0.0.1:<port>."
msgstr "dnsmasq 将转发到 127.0.0.1:<端口>。"

msgid "Cache entries"
msgstr "缓存条数"

msgid "Cache EDNS queries"
msgstr "缓存带 EDNS 的查询"

msgid "Required by most modern clients, whose queries carry an EDNS0 OPT record."
msgstr "现代客户端查询大多带 EDNS0 OPT 记录，开启后才能命中缓存。"

msgid "Block ad domains"
msgstr "拦截广告域名"

msgid "Uses geosite:category-ads-all from /usr/share/v2ray/geosite.dat."
msgstr "使用 /usr/share/v2ray/geosite.dat 中的 geosite:category-ads-all。"

msgid "Drop AAAA for proxied domains"
msgstr "丢弃代理域名的 AAAA 记录"

msgid "Prevents IPv6 answers from bypassing the proxy."
msgstr "防止 IPv6 解析结果绕过代理。"

msgid "Bootstrap resolver"
msgstr "Bootstrap 解析器"

msgid "Plain resolver used to resolve DoH/DoT hostnames and the node address."
msgstr "用于解析 DoH/DoT 域名与节点地址的普通 DNS。"

msgid "Foreign DNS server"
msgstr "国外 DNS 服务器"

msgid "Queried through the proxy for non-mainland domains."
msgstr "非国内域名通过代理向该服务器查询。"

msgid "Domestic upstreams"
msgstr "国内上游 DNS"

msgid "DoH/DoT/plain, one per line, e.g. https://dns.alidns.com/dns-query"
msgstr "支持 DoH/DoT/普通 DNS，每行一个，例如 https://dns.alidns.com/dns-query"

